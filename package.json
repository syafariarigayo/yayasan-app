{
  "name": "yayasan-app",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem Manajemen Yayasan Wakaf Cendekia - Frontend Application",
  "author": "Syafari Arigayo",
  "license": "MIT",
  "homepage": "https://github.com/syafariarigayo/yayasan-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/syafariarigayo/yayasan-app.git"
  },
  "bugs": {
    "url": "https://github.com/syafariarigayo/yayasan-app/issues"
  },
  "keywords": [
    "yayasan",
    "management",
    "hrms",
    "react",
    "frontend"
  ],
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dev": "npm start",
    "serve": "serve -s build",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "clean": "rm -rf build node_modules",
    "reinstall": "npm run clean && npm install",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "deploy": "npm run build && echo 'Ready to deploy!'"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.18"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"],
    "rules": {
      "no-restricted-globals": "off",
      "react-hooks/exhaustive-deps": "warn",
      "react/jsx-no-target-blank": "warn"
    }
  }
}
