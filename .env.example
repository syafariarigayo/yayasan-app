# ====================================================
# 🖥️ YAYASAN WAKAF CENDEKIA - FRONTEND CONFIG
# ====================================================
# Copy file ini ke .env dan sesuaikan nilainya
# ====================================================

# Backend API URL
REACT_APP_API_URL=http://localhost:5100

# App Configuration
REACT_APP_NAME=Yayasan Wakaf Cendekia
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=development

# Security
REACT_APP_TOKEN_KEY=token
REACT_APP_SESSION_TIMEOUT=60

# Upload Configuration
REACT_APP_MAX_FILE_SIZE=10

# Debugging
REACT_APP_DEBUG=true

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_EXPORT_EXCEL=true
REACT_APP_ENABLE_EXPORT_PDF=true

# Localization
REACT_APP_DEFAULT_LANG=id
REACT_APP_TIMEZONE=Asia/Jakarta

# Contact
REACT_APP_SUPPORT_EMAIL=support@yayasan.com